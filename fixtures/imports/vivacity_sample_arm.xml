<mujoco model="vivacity_sample_arm">
  <compiler angle="radian" balanceinertia="true" usethread="false"/>
  <option timestep="0.004" gravity="0 0 -9.81"/>
  <default>
    <joint damping="1.2" armature="0.025"/>
    <geom friction="0.8 0.01 0.001" density="750"/>
  </default>
  <worldbody>
    <body name="sample_base" pos="0.1 0 0.4">
      <geom name="base_plate" type="box" size="0.08 0.08 0.025" rgba="0.20 0.24 0.27 1"/>
      <body name="shoulder" pos="0 0 0.05">
        <joint name="shoulder_yaw" type="hinge" axis="0 0 1" range="-1.5 1.5"/>
        <geom name="shoulder_housing" type="cylinder" pos="0 0 0.06" size="0.057 0.065" rgba="0.74 0.78 0.78 1"/>
        <body name="upper_arm" pos="0 0 0.13">
          <joint name="shoulder_pitch" type="hinge" axis="0 1 0" range="-1.2 1.2"/>
          <geom name="upper_link" type="capsule" fromto="0 0 0 0.27 0 0" size="0.034" mass="1.8" rgba="0.77 0.81 0.80 1"/>
          <body name="elbow" pos="0.27 0 0">
            <joint name="elbow_flex" type="hinge" axis="0 1 0" range="-1.4 1.4"/>
            <geom name="elbow_housing" type="sphere" size="0.049" mass="0.35" rgba="0.20 0.24 0.27 1"/>
            <body name="forearm" pos="0.03 0 0">
              <geom name="forearm_link" type="capsule" fromto="0 0 0 0.23 0 0" size="0.026" mass="0.9" rgba="0.75 0.79 0.78 1"/>
              <body name="tool" pos="0.23 0 0">
                <geom name="tool_plate" type="box" size="0.035 0.048 0.012" mass="0.12" rgba="0.14 0.48 0.53 1"/>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
  <actuator>
    <position name="shoulder_yaw_motor" joint="shoulder_yaw" kp="45" ctrlrange="-1.5 1.5" forcerange="-22 22"/>
    <position name="shoulder_pitch_motor" joint="shoulder_pitch" kp="65" ctrlrange="-1.2 1.2" forcerange="-18 18"/>
    <position name="elbow_motor" joint="elbow_flex" kp="36" ctrlrange="-1.4 1.4" forcerange="-0.8 0.8"/>
  </actuator>
</mujoco>
